* text=auto
*.sh text eol=lf
Dockerfile* text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.sql text eol=lf

# Preserve exact bytes already published/applied by Shopify 1.1.1.
# These overrides change checkout policy, not migration SQL or recorded checksums.
modules/shopify/migrations/003-operational-conditions.sql text eol=crlf
modules/shopify/migrations/004-publication-gate.sql text eol=crlf

# Preserve bytes of existing Sales 1.2.x applied migrations.
modules/sales/migrations/004-financial-evidence.sql text eol=crlf
modules/sales/migrations/005-atomic-financial-projection.sql text eol=crlf

# Participant 1.0.0 was published with mixed line endings. Preserve its exact
# applied bytes; neither LF nor CRLF normalization reproduces that checksum.
modules/participant-services/migrations/001-foundation.sql -text

# Printify 1.1.2 shares the already published CRLF migrations with Shopify.
# Preserve their recorded applied hashes in fresh checkouts as well.
modules/printify/migrations/003-operational-conditions.sql text eol=crlf
modules/printify/migrations/004-publication-gate.sql text eol=crlf

# Phase 15 signed/applied migration bytes are immutable. Checkout policy only:
# never regenerate their manifest hashes or rebuild an already published version.
modules/catalog/migrations/001-foundation.sql text eol=crlf
modules/catalog/migrations/002-operational-references.sql text eol=crlf
modules/catalog/migrations/004-analytical-publications.sql text eol=crlf
modules/pricing/migrations/001-foundation.sql text eol=crlf
modules/pricing/migrations/003-analytical-publications.sql text eol=crlf
modules/inventory/migrations/006-verified-stock.sql text eol=crlf
modules/stock-ledger/migrations/003-verified-stock.sql text eol=crlf
modules/shopify/migrations/005-external-catalog.sql text eol=crlf
modules/printify/migrations/005-external-catalog.sql text eol=crlf
modules/printify/migrations/006-cost-evidence.sql text eol=crlf
modules/sales/migrations/009-analytical-publications.sql text eol=crlf

# These two were signed with mixed CRLF/LF endings, like Participant 001 above.
# Preserve their existing exact working bytes in Git; no text conversion is safe.
modules/catalog/migrations/003-external-catalog.sql -text
modules/pricing/migrations/002-cost-evidence.sql -text

# Order matching 1.4.0 was signed/applied with CRLF bytes. Preserve them in
# clean checkouts without changing either SQL contents or recorded checksums.
modules/shopify/migrations/006-order-monitoring.sql text eol=crlf
modules/printify/migrations/007-order-observations.sql text eol=crlf

# Monitored commerce 1.7.0 signed bytes contain mixed endings; preserve exactly.
modules/shopify/migrations/007-monitored-commerce.sql -text

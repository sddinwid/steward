* text=auto
*.sh text eol=lf
Dockerfile* text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.sql text eol=lf

# Preserve exact bytes already published/applied by Shopify 1.1.1.
# These overrides change checkout policy, not migration SQL or recorded checksums.
modules/shopify/migrations/003-operational-conditions.sql text eol=crlf
modules/shopify/migrations/004-publication-gate.sql text eol=crlf

# Preserve bytes of existing Sales 1.2.x applied migrations.
modules/sales/migrations/004-financial-evidence.sql text eol=crlf
modules/sales/migrations/005-atomic-financial-projection.sql text eol=crlf

# Participant 1.0.0 was published with mixed line endings. Preserve its exact
# applied bytes; neither LF nor CRLF normalization reproduces that checksum.
modules/participant-services/migrations/001-foundation.sql -text

# Printify 1.1.2 shares the already published CRLF migrations with Shopify.
# Preserve their recorded applied hashes in fresh checkouts as well.
modules/printify/migrations/003-operational-conditions.sql text eol=crlf
modules/printify/migrations/004-publication-gate.sql text eol=crlf

{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "moduleId": "steward.automation",
  "version": "1.0.0",
  "name": "Business Automation",
  "description": "Module-owned workflow definitions and immutable human review. Execution requires separate Worker-governed activation.",
  "minimumPlatformVersion": "0.16.0",
  "dependencies": [],
  "requiredPermissions": [
    "storage.own-database"
  ],
  "api": [
    {
      "operationId": "listWorkflows",
      "method": "GET",
      "path": "/workflows",
      "permission": "steward.automation.read",
      "query": [
        "limit",
        "offset",
        "q",
        "status"
      ]
    },
    {
      "operationId": "createWorkflow",
      "method": "POST",
      "path": "/workflows",
      "permission": "steward.automation.edit"
    },
    {
      "operationId": "updateWorkflow",
      "method": "PUT",
      "path": "/workflows/:id",
      "permission": "steward.automation.edit"
    },
    {
      "operationId": "publishWorkflow",
      "method": "POST",
      "path": "/publish/:id",
      "permission": "steward.automation.publish"
    },
    {
      "operationId": "listPublications",
      "method": "GET",
      "path": "/publications",
      "permission": "steward.automation.read",
      "query": [
        "q"
      ]
    },
    {
      "operationId": "listReviews",
      "method": "GET",
      "path": "/reviews",
      "permission": "steward.automation.read"
    },
    {
      "operationId": "reviewPublication",
      "method": "POST",
      "path": "/reviews",
      "permission": "steward.automation.approve"
    },
    {
      "operationId": "workflowStatus",
      "method": "GET",
      "path": "/workflow-status",
      "permission": "steward.automation.read"
    }
  ],
  "ui": [
    {
      "screenId": "workflows",
      "title": "Business workflows",
      "navigationLabel": "Workflow designer",
      "formVersion": 1,
      "navigationGroup": "Automation",
      "listOperation": "listWorkflows",
      "createOperation": "createWorkflow",
      "updateOperation": "updateWorkflow",
      "fields": [
        {
          "name": "recordKey",
          "label": "Record identity",
          "type": "string",
          "required": true,
          "generate": "uuid"
        },
        {
          "name": "name",
          "label": "Workflow name",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "label": "Purpose",
          "type": "string",
          "required": true,
          "format": "multiline"
        },
        {
          "name": "graph",
          "label": "Workflow graph",
          "type": "json",
          "required": true,
          "format": "workflow"
        },
        {
          "name": "status",
          "label": "State",
          "type": "string",
          "required": true,
          "readOnly": true
        }
      ],
      "columns": [
        "name",
        "description",
        "status"
      ],
      "actions": [
        {
          "label": "Publish immutable version",
          "operationId": "publishWorkflow",
          "confirmation": "Publish this definition as an immutable version for separate review? Publication does not activate execution."
        }
      ]
    },
    {
      "screenId": "reviews",
      "title": "Workflow review",
      "navigationLabel": "Workflow approvals",
      "formVersion": 1,
      "navigationGroup": "Automation",
      "listOperation": "listReviews",
      "createOperation": "reviewPublication",
      "fields": [
        {
          "name": "recordKey",
          "label": "Record identity",
          "type": "string",
          "required": true,
          "generate": "uuid"
        },
        {
          "name": "publicationId",
          "label": "Published version",
          "type": "string",
          "required": true,
          "reference": {
            "operationId": "listPublications",
            "valueField": "id",
            "labelField": "name"
          }
        },
        {
          "name": "decision",
          "label": "Decision",
          "type": "string",
          "required": true,
          "enum": [
            "approve",
            "reject",
            "revoke"
          ]
        },
        {
          "name": "reason",
          "label": "Review reason",
          "type": "string",
          "required": true,
          "format": "multiline"
        },
        {
          "name": "validForMinutes",
          "label": "Approval validity (minutes)",
          "type": "number",
          "required": true,
          "minimum": 1,
          "maximum": 44640,
          "default": 60
        }
      ],
      "columns": [
        "publicationId",
        "decision",
        "reason"
      ]
    },
    {
      "screenId": "status",
      "title": "Workflow definition status",
      "navigationLabel": "Workflow status",
      "listOperation": "workflowStatus",
      "fields": [
        {
          "name": "name",
          "label": "Workflow",
          "type": "string",
          "required": true,
          "readOnly": true
        },
        {
          "name": "status",
          "label": "Definition state",
          "type": "string",
          "required": true,
          "readOnly": true
        },
        {
          "name": "version",
          "label": "Published version",
          "type": "number",
          "required": true,
          "readOnly": true
        }
      ],
      "columns": [
        "name",
        "status",
        "version"
      ]
    }
  ],
  "approvalServices": {
    "contractVersion": 1,
    "reviewerPermission": "steward.automation.approve"
  },
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "maxElapsedMs",
      "maxParallel"
    ],
    "properties": {
      "maxElapsedMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 2678400000
      },
      "maxParallel": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      }
    }
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 1,
    "migrations": [
      {
        "version": 1,
        "sha256": "be6fde9457a615d3456c458192d5f0a873965084b3295fdf9af7bd4fd8bffd36"
      }
    ],
    "destructiveRollback": false
  },
  "integrationEvents": [],
  "analyticalCapabilities": [],
  "mcpTools": [
    {
      "name": "automation_workflow_status",
      "description": "Read workflow definition versions and review status. Does not approve, activate or execute workflows.",
      "operationId": "workflowStatus"
    }
  ],

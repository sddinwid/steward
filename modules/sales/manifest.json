  "smart": {
    "version": 1,
    "provides": [
      {
        "capabilityId": "commerce.orders.manage",
        "contract": "steward.channel-order",
        "version": "1.0.0",
        "operations": [
          {
            "name": "commerce.order.import",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "sourceCreatedAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "\\S"
                },
                "sourceUpdatedAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "\\S"
                },
                "channel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "financialStatus": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "paid",
                    "refunded",
                    "partially_refunded",
                    "authorized",
                    "partially_paid",
                    "voided",
                    "expired"
                  ]
                },
                "fulfillmentStatus": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "canceled": {
                  "type": "boolean"
                },
                "refundCents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sourceVariantId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "\\S"
                      },
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000000
                      },
                      "unitPriceCents": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "lineRevenueCents": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "sourceVariantId",
                      "sku",
                      "quantity",
                      "unitPriceCents",
                      "lineRevenueCents"
                    ]
                  }
                }
              },
              "required": [
                "sourceId",
                "sourceCreatedAt",
                "sourceUpdatedAt",
                "channel",
                "currency",
                "financialStatus",
                "fulfillmentStatus",
                "canceled",
                "refundCents",
                "lines"
              ]
            },
            "output": {

{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "moduleId": "cee.sales",
  "version": "1.0.0",
  "name": "Sales",
  "description": "Independent persistent sales business module. Human authorization is required for approval and ecosystem publication.",
  "minimumPlatformVersion": "0.7.0",
  "dependencies": [],
  "requiredPermissions": [
    "storage.own-database"
  ],
  "api": [
    {
      "operationId": "listCustomer",
      "method": "GET",
      "path": "/customers",
      "permission": "cee.sales.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "createCustomer",
      "method": "POST",
      "path": "/customers",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "updateCustomer",
      "method": "PUT",
      "path": "/customers/:id",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "listOrder",
      "method": "GET",
      "path": "/orders",
      "permission": "cee.sales.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "createOrder",
      "method": "POST",
      "path": "/orders",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "updateOrder",
      "method": "PUT",
      "path": "/orders/:id",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "confirm",
      "method": "POST",
      "path": "/confirm/:id",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "cancel",
      "method": "POST",
      "path": "/cancel/:id",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "listFulfillment",
      "method": "GET",
      "path": "/fulfillments",
      "permission": "cee.sales.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "createFulfillment",
      "method": "POST",
      "path": "/fulfillments",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "updateFulfillment",
      "method": "PUT",
      "path": "/fulfillments/:id",
      "permission": "cee.sales.write"
    },
    {
      "operationId": "reports",
      "method": "GET",
      "path": "/reports",
      "permission": "cee.sales.read"
    },
    {
      "operationId": "integrationStatus",
      "method": "GET",
      "path": "/integration-status",
      "permission": "cee.sales.read"
    }
  ],
  "ui": [
    {
      "screenId": "customer",
      "title": "Sales — customer",
      "navigationLabel": "sales customer",
      "listOperation": "listCustomer",
      "createOperation": "createCustomer",
      "updateOperation": "updateCustomer",
      "fields": [
        {
          "name": "code",
          "label": "Code",
          "type": "string",
          "required": true,
          "maxLength": 60
        },
        {
          "name": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 160
        },
        {
          "name": "reference",
          "label": "Reference",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "status",
          "label": "Status",
          "type": "string",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "code",
        "name",
        "reference",
        "status"
      ]
    },
    {
      "screenId": "order",
      "title": "Sales — order",
      "navigationLabel": "sales order",
      "listOperation": "listOrder",
      "createOperation": "createOrder",
      "updateOperation": "updateOrder",
      "fields": [
        {
          "name": "number",
          "label": "Number",
          "type": "string",
          "required": true,
          "maxLength": 80
        },
        {
          "name": "customerCode",
          "label": "Customer Code",
          "type": "string",
          "required": true,
          "maxLength": 60
        },
        {
          "name": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "maxLength": 3
        },
        {
          "name": "lines",
          "label": "Lines",
          "type": "json",
          "required": true
        },
        {
          "name": "status",
          "label": "Status",
          "type": "string",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "number",
        "customerCode",
        "currency",
        "lines",
        "status"
      ],
      "actions": [
        {
          "label": "confirm",
          "operationId": "confirm"
        },
        {
          "label": "cancel",
          "operationId": "cancel"
        }
      ]
    },
    {
      "screenId": "fulfillment",
      "title": "Sales — fulfillment",
      "navigationLabel": "sales fulfillment",
      "listOperation": "listFulfillment",
      "createOperation": "createFulfillment",
      "updateOperation": "updateFulfillment",
      "fields": [
        {
          "name": "number",
          "label": "Number",
          "type": "string",
          "required": true,
          "maxLength": 80
        },
        {
          "name": "orderNumber",
          "label": "Order Number",
          "type": "string",
          "required": true,
          "maxLength": 80
        },
        {
          "name": "lines",
          "label": "Lines",
          "type": "json",
          "required": true
        },
        {
          "name": "status",
          "label": "Status",
          "type": "string",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "number",
        "orderNumber",
        "lines",
        "status"
      ]
    },
    {
      "screenId": "reports",
      "title": "sales reports",
      "navigationLabel": "sales reports",
      "listOperation": "reports",
      "fields": [
        {
          "name": "metric",
          "label": "metric",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "value",
          "label": "value",
          "type": "json",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "metric",
        "value"
      ]
    },
    {
      "screenId": "integration-status",
      "title": "Integration delivery status",
      "navigationLabel": "sales delivery",
      "listOperation": "integrationStatus",
      "fields": [
        {
          "name": "command",
          "label": "command",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "target",
          "label": "target",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "status",
          "label": "status",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "attempts",
          "label": "attempts",
          "type": "number",
          "required": false,
          "readOnly": true
        },
        {
          "name": "error",
          "label": "error",
          "type": "string",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "command",
        "target",
        "status",
        "attempts",
        "error"
      ]
    }
  ],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "currency",
      "integrationsEnabled"
    ],
    "properties": {
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 1,
    "migrations": [],
    "destructiveRollback": false
  },
  "integrationEvents": [
    {
      "name": "cee.sales.record-changed",
      "version": 1,
      "direction": "produced"
    }
  ],
  "analyticalCapabilities": [
    {
      "name": "sales.summary",
      "version": 1
    }
  ],
  "integration": {
    "version": 1,
    "outboxPath": "/integration-outbox",
    "acknowledgmentPath": "/integration-ack",
    "inboxPath": "/integration-inbox",
    "peers": [
      {
        "moduleId": "cee.inventory",
        "minimumVersion": "1.3.0",
        "sends": [
          {
            "command": "stock.reserve",
            "version": 1
          },
          {
            "command": "stock.release",
            "version": 1
          },
          {
            "command": "stock.consume",
            "version": 1
          }
        ],
        "receives": []
      }
    ]
  },
  "mcpTools": [
    {
      "name": "sales_listcustomer",
      "description": "Read authorized sales listCustomer; paginated module-owned evidence.",
      "operationId": "listCustomer"
    },
    {
      "name": "sales_listorder",
      "description": "Read authorized sales listOrder; paginated module-owned evidence.",
      "operationId": "listOrder"
    },
    {
      "name": "sales_listfulfillment",
      "description": "Read authorized sales listFulfillment; paginated module-owned evidence.",
      "operationId": "listFulfillment"
    },
    {
      "name": "sales_reports",
      "description": "Read authorized sales reports; paginated module-owned evidence.",
      "operationId": "reports"
    }
  ]
}

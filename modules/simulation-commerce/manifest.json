                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              },
              "required": [
                "updated"
              ]
            }
          },
          {
            "name": "simulation.sales.advance",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "action": {

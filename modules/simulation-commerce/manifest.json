              },
              "required": [
                "orderId",
                "status"
              ]
            }
          },
          {
            "name": "simulation.sales.inspect",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                }
              },
              "required": [
                "orderId"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "status": {
                  "type": "string",
                  "maxLength": 80,
                  "minLength": 1
                },
                "stockStatus": {
                  "type": "string",
                  "maxLength": 80,
                  "minLength": 1
                },
                "productionStatus": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 80,
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500,
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "orderId",
                "status",
                "stockStatus",
                "productionStatus",
                "error"
              ]
            }
          },
          {
            "name": "simulation.sales.observe",
            "input": {

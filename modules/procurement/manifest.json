    "version": 1,
    "provides": [
      {
        "capabilityId": "procurement.service-replenishment",
        "contract": "steward.service-replenishment",
        "version": "1.0.0",
        "sensitivity": "restricted",
        "scope": "entity",
        "ownership": "provider",
        "configuration": {
          "syntheticServiceReplenishment": true,
          "integrationsEnabled": true

  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "currency",
      "integrationsEnabled"
    ],
    "properties": {
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 1,
    "migrations": [],
    "destructiveRollback": false
  },
  "integrationEvents": [
    {
      "name": "cee.procurement.record-changed",
      "version": 1,
      "direction": "produced"
    }
  ],
  "analyticalCapabilities": [
    {
      "name": "procurement.summary",
      "version": 1
    }
  ],
  "integration": {
    "version": 1,
    "outboxPath": "/integration-outbox",
    "acknowledgmentPath": "/integration-ack",
    "inboxPath": "/integration-inbox",
    "peers": [
      {
        "moduleId": "cee.inventory",
        "minimumVersion": "1.3.0",
        "sends": [
          {
            "command": "goods.received",
            "version": 1
          }
        ],
        "receives": [
          {
            "command": "stock.replenishment",
            "version": 1
          }
        ]
      }
    ]
  },

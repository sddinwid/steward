  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "currency",
      "integrationsEnabled"
    ],
    "properties": {
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      },
      "syntheticServiceReplenishment": {
        "type": "boolean",
        "default": false
      },
      "serviceAuthorityProgramId": {
        "type": "string",
        "pattern": "^(?:|[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12})$",
        "default": ""
      }
    }
  },

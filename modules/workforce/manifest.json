  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "currency",
      "integrationsEnabled",
      "syntheticOnly",
      "minimumGroupSize"
    ],
    "properties": {
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      },
      "syntheticOnly": {
        "type": "boolean",
        "enum": [
          true
        ],
        "default": true
      },
      "minimumGroupSize": {
        "type": "integer",
        "minimum": 3,
        "maximum": 100,
        "default": 3
      }
    }
  },

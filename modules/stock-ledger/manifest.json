{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "moduleId": "cee.stock-ledger",
  "version": "1.0.0",
  "name": "Stock-ledger",
  "description": "Independent SSMA stock-ledger module; simulator/live mode and authority remain explicit.",
  "minimumPlatformVersion": "0.8.0",
  "dependencies": [],
  "requiredPermissions": [
    "storage.own-database"
  ],
  "api": [
    {
      "operationId": "listitem",
      "method": "GET",
      "path": "/items",
      "permission": "cee.stock-ledger.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "createitem",
      "method": "POST",
      "path": "/items",
      "permission": "cee.stock-ledger.write"
    },
    {
      "operationId": "updateitem",
      "method": "PUT",
      "path": "/items/:id",
      "permission": "cee.stock-ledger.write"
    },
    {
      "operationId": "listreservation",
      "method": "GET",
      "path": "/reservations",
      "permission": "cee.stock-ledger.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    }
  ],
  "ui": [
    {
      "screenId": "item",
      "title": "stock-ledger — item",
      "navigationLabel": "stock-ledger item",
      "listOperation": "listitem",
      "createOperation": "createitem",
      "updateOperation": "updateitem",
      "fields": [
        {
          "name": "sku",
          "label": "sku",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "label": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "quantity",
          "label": "quantity",
          "type": "number",
          "required": true
        }
      ],
      "columns": [
        "sku",
        "name",
        "quantity"
      ]
    },
    {
      "screenId": "reservation",
      "title": "stock-ledger — reservation",
      "navigationLabel": "stock-ledger reservation",
      "listOperation": "listreservation",
      "fields": [
        {
          "name": "orderId",
          "label": "orderId",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "lines",
          "label": "lines",
          "type": "json",
          "required": false,
          "readOnly": true
        },
        {
          "name": "status",
          "label": "status",
          "type": "string",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "orderId",
        "lines",
        "status"
      ]
    }
  ],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "currency": {
        "type": "string",
        "enum": [
          "EUR",
          "USD",
          "GBP",
          "CAD",
          "AUD",
          "NZD"
        ],
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": true
      }
    },
    "required": [
      "currency",
      "integrationsEnabled"
    ]
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 1,
    "migrations": [],
    "destructiveRollback": false
  },
  "integrationEvents": [],
  "analyticalCapabilities": [],
  "integration": {
    "version": 1,
    "outboxPath": "/integration-outbox",
    "acknowledgmentPath": "/integration-ack",
    "inboxPath": "/integration-inbox",
    "peers": []
  },
  "smart": {
    "version": 1,
    "provides": [
      {
        "capabilityId": "inventory.stock.reserve",
        "contract": "steward.stock-reservations",
        "version": "1.0.0",
        "operations": [
          {
            "name": "stock.reserve",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000000
                      }
                    },
                    "required": [
                      "sku",
                      "quantity"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "lines"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "requested": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "availableBefore": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "reserved": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "sku",
                      "requested",
                      "availableBefore",
                      "reserved"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "lines"
              ]
            },
            "command": "stock.reserve",
            "permission": "cee.stock-ledger.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          },
          {
            "name": "stock.release",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                }
              },
              "required": [
                "orderId"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "released": {
                  "const": true
                }
              },
              "required": [
                "orderId",
                "released"
              ]
            },
            "command": "stock.release",
            "permission": "cee.stock-ledger.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          },
          {
            "name": "stock.consume",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "fulfillmentId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000000
                      }
                    },
                    "required": [
                      "sku",
                      "quantity"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "fulfillmentId",
                "lines"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "fulfillmentId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "applied": {
                  "const": true
                }
              },
              "required": [
                "orderId",
                "fulfillmentId",
                "applied"
              ]
            },
            "command": "stock.consume",
            "permission": "cee.stock-ledger.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          }
        ],
        "events": [],
        "sensitivity": "business",
        "scope": "entity",
        "ownership": "provider"
      }
    ],
    "consumes": [],
    "prerequisites": {
      "configuration": {
        "integrationsEnabled": true
      },
      "requiresActive": true,
      "requiresHealthy": true
    }
  },
  "mcpTools": [
    {
      "name": "stock_ledger_reservation",
      "description": "Read paginated authorized stock-ledger reservation evidence; credentials and personal information excluded.",
      "operationId": "listreservation"
    }
  ]
}

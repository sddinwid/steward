        "streamId": "capacities",
        "table": "capacities",
        "idColumn": "id",
        "revisionColumn": "revision",
        "columns": [
          "id",
          "revision",
          "name",
          "site",
          "capacity_m3",
          "utilized_m3",
          "available_m3",

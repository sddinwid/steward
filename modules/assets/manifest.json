  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "currency",
      "integrationsEnabled",
      "authorizedOwnerEntityIds"
    ],
    "properties": {
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      },
      "authorizedOwnerEntityIds": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 50,
        "items": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "default": []
      },
      "serviceAuthorityProgramId": {
        "type": "string",
        "pattern": "^(?:|[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12})$",
        "default": ""
      },
      "syntheticServiceAuthority": {
        "type": "boolean",
        "default": false
      },
      "authorizedManagerEntityIds": {
        "type": "array",
        "maxItems": 50,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
        },
        "default": []
      }
    }
  },

  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "currency",
      "integrationsEnabled",
      "authorizedOwnerEntityIds"
    ],
    "properties": {
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      },
      "authorizedOwnerEntityIds": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 50,
        "items": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "default": []
      }
    }
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 1,
    "migrations": [],
    "destructiveRollback": false
  },
  "integrationEvents": [
    {
      "name": "cee.assets.record-changed",
      "version": 1,
      "direction": "produced"
    }
  ],
  "analyticalCapabilities": [
    {
      "name": "assets.summary",
      "version": 1
    }
  ],
  "integration": {
    "version": 1,
    "outboxPath": "/integration-outbox",
    "acknowledgmentPath": "/integration-ack",
    "inboxPath": "/integration-inbox",
    "peers": []
  },

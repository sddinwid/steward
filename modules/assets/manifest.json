  "smart": {
    "version": 1,
    "provides": [
      {
        "capabilityId": "property.authority",
        "contract": "steward.property-authority",
        "version": "1.0.0",
        "sensitivity": "business",
        "scope": "entity",
        "ownership": "provider",
        "configuration": {
          "integrationsEnabled": true,
          "syntheticServiceAuthority": true
        },
        "operations": [
          {
            "name": "catalog",
            "command": "property.authority.catalog",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "programId",
                "sourceProgramId"
              ],
              "properties": {
                "programId": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
                },
                "sourceProgramId": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "records",
                "nextOffset",
                "synthetic"
              ],
              "properties": {
                "records": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "assetId",
                      "name",
                      "site",
                      "ownerEntityId",
                      "classification",
                      "assetRevision",
                      "available"
                    ],
                    "properties": {
                      "assetId": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "site": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "ownerEntityId": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
                      },
                      "classification": {
                        "type": "string",
                        "const": "residential"
                      },
                      "assetRevision": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "available": {
                        "type": "boolean"

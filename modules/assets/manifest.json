      "permission": "cee.assets.write"
    },
    {
      "operationId": "updateMaintenance",
      "method": "PUT",
      "path": "/maintenance/:id",
      "permission": "cee.assets.write"
    },
    {
      "operationId": "complete",
      "method": "POST",
      "path": "/complete/:id",
      "permission": "cee.assets.maintain"
    },
    {
      "operationId": "listBooking",
      "method": "GET",

      "updateOperation": "updatecapacities",
      "fields": [
        {
          "name": "name",
          "label": "Record name",
          "type": "string",
          "required": true,
          "maxLength": 160
        },
        {
          "name": "site",
          "label": "Location",
          "type": "string",
          "required": true,
          "maxLength": 160
        },
        {
          "name": "capacity_m3",
          "label": "Total capacity (m³)",
          "type": "number",
          "required": true,
          "minimum": 0
        },
        {
          "name": "utilized_m3",
          "label": "Utilized capacity (m³)",
          "type": "number",
          "required": true,
          "minimum": 0
        },
        {
          "name": "monthly_operating_cost",
          "label": "Monthly operating cost",

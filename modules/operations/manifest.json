  ],
  "api": [
    {
      "operationId": "listcapacities",
      "method": "GET",
      "path": "/capacities",
      "permission": "cee.operations.read"
    },
    {
      "operationId": "createcapacities",
      "method": "POST",
      "path": "/capacities",
      "permission": "cee.operations.write"
    },
    {
      "operationId": "updatecapacities",
      "method": "PUT",
      "path": "/capacities/:id",
      "permission": "cee.operations.write"
    },
    {
      "operationId": "liststorage",
      "method": "GET",
      "path": "/storage",
      "permission": "cee.operations.read"
    },
    {
      "operationId": "createstorage",
      "method": "POST",
      "path": "/storage",
      "permission": "cee.operations.write"
    },
    {
      "operationId": "updatestorage",
      "method": "PUT",
      "path": "/storage/:id",
      "permission": "cee.operations.write"
    },
    {
      "operationId": "listassets",
      "method": "GET",
      "path": "/assets",
      "permission": "cee.operations.read"
    },
    {
      "operationId": "createassets",
      "method": "POST",
      "path": "/assets",
      "permission": "cee.operations.write"
    },
    {
      "operationId": "updateassets",
      "method": "PUT",
      "path": "/assets/:id",
      "permission": "cee.operations.write"
    }

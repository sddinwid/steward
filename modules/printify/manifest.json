        {
          "name": "status",
          "label": "status",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "error",
          "label": "error",
          "type": "string",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [

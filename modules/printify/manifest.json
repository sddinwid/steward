        {
          "name": "productId",
          "label": "productId",
          "type": "string",
          "required": true
        },
        {
          "name": "variantId",
          "label": "variantId",
          "type": "number",
          "required": true
        }
      ],
      "columns": [
        "sku",
        "productId",
        "variantId"
      ]
    },
    {
      "screenId": "connection",
      "title": "printify \u00e2\u20ac\u201d connection",
      "navigationLabel": "printify connection",
      "listOperation": "listconnection",
      "fields": [
        {
          "name": "name",
          "label": "name",
          "type": "string",

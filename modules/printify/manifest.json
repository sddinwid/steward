    {
      "screenId": "external-order",
      "title": "Native and external fulfillment monitoring",
      "navigationLabel": "Native Printify Fulfillment",
      "listOperation": "listExternalOrders",
      "fields": [
        {
          "name": "sourceId",
          "label": "source Id",
          "type": "string",
          "readOnly": true,
          "required": false
        },
        {
          "name": "externalId",
          "label": "external Id",
          "type": "string",
          "readOnly": true,

    {
      "screenId": "shop",
      "title": "Printify - configured shop",
      "navigationLabel": "printify shop",
      "listOperation": "listshop",
      "fields": [
        {
          "name": "sourceId",
          "label": "sourceId",
          "type": "string",
          "readOnly": true,
          "required": false
        },
        {
          "name": "title",
          "label": "title",
          "type": "string",
          "readOnly": true,

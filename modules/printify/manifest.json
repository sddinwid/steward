  ],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "currency": {
        "type": "string",
        "enum": [
          "EUR",
          "USD",
          "GBP",
          "CAD",
          "AUD",
          "NZD"
        ],
        "default": "EUR"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": true
      },
      "mode": {
        "type": "string",
        "enum": [
          "simulator",
          "live"
        ],
        "default": "simulator"
      },
      "productionEnabled": {
        "type": "boolean",
        "default": false
      },
      "maximumOrderCostCents": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000000,
        "default": 10000
      },
      "publishOperationalAlerts": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "currency",
      "integrationsEnabled",
      "mode",
      "productionEnabled",
      "maximumOrderCostCents"
    ]
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 4,
    "migrations": [],
    "destructiveRollback": false
  },
  "integrationEvents": [],
  "analyticalCapabilities": [],
  "integration": {
    "version": 1,
    "outboxPath": "/integration-outbox",
    "acknowledgmentPath": "/integration-ack",
    "inboxPath": "/integration-inbox",
    "peers": []
  },
  "smart": {
    "version": 1,
    "provides": [
      {
        "capabilityId": "fulfillment.orders.submit",
        "contract": "steward.production-intent",
        "version": "1.0.0",
        "operations": [
          {
            "name": "fulfillment.submit",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000000
                      }
                    },
                    "required": [
                      "sku",
                      "quantity"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "currency",
                "lines"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "jobId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "status": {
                  "const": "awaiting_authorization"
                }
              },
              "required": [
                "jobId",
                "status"
              ]
            },
            "command": "fulfillment.submit",
            "permission": "cee.printify.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          },
          {
            "name": "fulfillment.cancel",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                }
              },
              "required": [
                "orderId"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "canceled": {
                  "type": "boolean"
                }
              },
              "required": [
                "canceled"
              ]
            },
            "command": "fulfillment.cancel",
            "permission": "cee.printify.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          }
        ],
        "events": [],
        "sensitivity": "business",
        "scope": "entity",
        "ownership": "provider"
      }
    ],
    "consumes": [
      {
        "capabilityId": "commerce.orders.fulfillment",
        "contract": "steward.production-progress",
        "minimumVersion": "1.0.0",
        "maximumMajor": 1,
        "operations": [
          {
            "name": "fulfillment.progress",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_production",
                    "shipped",
                    "failed"
                  ]
                },
                "updatedAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "\\S"
                },
                "productionCostCents": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "shippingCostCents": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "costBasis": {
                  "type": "string",
                  "enum": [
                    "estimated",
                    "known",
                    "incomplete"
                  ]
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "tracking": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "\\S"
                }
              },
              "required": [
                "orderId",
                "sourceId",
                "status",
                "updatedAt",
                "productionCostCents",
                "shippingCostCents",
                "costBasis",
                "currency",
                "tracking"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "recorded": {
                  "const": true
                }
              },
              "required": [
                "recorded"
              ]
            }
          }
        ],
        "events": [],
        "maximumSensitivity": "business",
        "optional": false
      }
    ],
    "prerequisites": {
      "configuration": {
        "integrationsEnabled": true
      },
      "requiresActive": true,
      "requiresHealthy": true
    }
  },
  "mcpTools": [
    {
      "name": "printify_connection",
      "description": "Read paginated authorized printify connection evidence; credentials and personal information excluded.",
      "operationId": "listconnection"
    },
    {
      "name": "printify_product",
      "description": "Read paginated authorized printify product evidence; credentials and personal information excluded.",
      "operationId": "listproduct"
    },
    {
      "name": "printify_job",
      "description": "Read paginated authorized printify job evidence; credentials and personal information excluded.",
      "operationId": "listjob"
    },
    {
      "name": "printify_shop",
      "description": "Read only the configured authorized shop identity and source channel, without credentials.",
      "operationId": "listshop"
    },
    {
      "name": "printify_exceptions",
      "description": "Read-only connector conditions; uncertain provider outcomes require reconciliation.",
      "operationId": "commerceExceptions"
    }
  ],
  "connector": {
    "version": 1,
    "provider": "printify",
    "webhookTopics": [
      "order:created",
      "order:updated",
      "order:sent-to-production",
      "order:shipment:created"
    ]
  },
  "replication": {
    "contractVersion": 1,
    "streams": [
      {
        "streamId": "commerce_exceptions",
        "table": "commerce_exceptions",
        "idColumn": "id",
        "revisionColumn": "revision",
        "columns": [
          "id",
          "revision",
          "projection"
        ]
      }
    ]
  }
}

{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "moduleId": "cee.printify",
  "version": "1.1.1",
  "name": "Printify",
  "description": "Independent SSMA printify module; simulator/live mode and authority remain explicit.",
  "minimumPlatformVersion": "0.10.0",
  "dependencies": [],
  "requiredPermissions": [
    "storage.own-database"
  ],
  "api": [
    {
      "operationId": "listmapping",
      "method": "GET",
      "path": "/mappings",
      "permission": "cee.printify.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "createmapping",
      "method": "POST",
      "path": "/mappings",
      "permission": "cee.printify.write"
    },
    {
      "operationId": "updatemapping",
      "method": "PUT",
      "path": "/mappings/:id",
      "permission": "cee.printify.write"
    },
    {
      "operationId": "listconnection",
      "method": "GET",
      "path": "/connections",
      "permission": "cee.printify.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "synchronize",
      "method": "POST",
      "path": "/synchronize/:id",
      "permission": "cee.printify.write"
    },
    {
      "operationId": "listproduct",
      "method": "GET",
      "path": "/catalog",
      "permission": "cee.printify.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "listjob",
      "method": "GET",
      "path": "/jobs",
      "permission": "cee.printify.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "authorize",
      "method": "POST",
      "path": "/authorize/:id",
      "permission": "cee.printify.production.authorize"
    },
    {
      "operationId": "reconcile",
      "method": "POST",
      "path": "/reconcile/:id",
      "permission": "cee.printify.write"
    },
    {
      "operationId": "listshop",
      "method": "GET",
      "path": "/shops",
      "permission": "cee.printify.read",
      "query": [
        "limit",
        "offset",
        "fields"
      ]
    },
    {
      "operationId": "listExternalOrders",
      "method": "GET",
      "path": "/external-orders",
      "permission": "cee.printify.read",
      "query": [
        "limit",
        "offset",
        "fields",
        "status",
        "q"
      ]
    },
    {
      "operationId": "commerceExceptions",
      "method": "GET",
      "path": "/commerce-exceptions",
      "permission": "cee.printify.read"
    }
  ],
  "ui": [

        {
          "name": "orderId",
          "label": "orderId",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "remoteId",
          "label": "remoteId",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "status",
          "label": "status",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "productionCostCents",
          "label": "productionCostCents",
          "type": "number",

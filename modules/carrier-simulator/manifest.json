                "trackingNumber"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "registrationId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                }
              },
              "required": [
                "registrationId"
              ]
            },
            "permission": "steward.carrier.simulator.tracking.register",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          }
        ],
        "events": [],
        "sensitivity": "business",
        "scope": "entity",
        "ownership": "provider"

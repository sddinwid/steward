                      "fresh": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "registrationId",
                      "status",
                      "fresh"
                    ]
                  }
                },
                "nextOffset": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "required": [
                "synthetic",
                "records",
                "nextOffset"
              ]
            },
            "permission": "steward.carrier.simulator.read",
            "mode": "sync",
            "idempotency": "required",
            "retry": "safe"

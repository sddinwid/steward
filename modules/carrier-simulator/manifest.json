        "operations": [
          {
            "name": "tracking.summary",
            "command": "summary",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "synthetic": {

              },
              "required": [
                "programId",
                "sourceProgramId",
                "itemId",
                "reservationId",
                "quantity"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "itemId": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
                },
                "reservationId": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
                },
                "reserved": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "consumed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "reserved",
                    "consumed",
                    "released"
                  ]
                },
                "synthetic": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "itemId",
                "reservationId",
                "reserved",
                "consumed",
                "status",
                "synthetic"
              ]
            },
            "command": "service-stock.reserve",
            "permission": "cee.inventory.service.manage",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"

{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "moduleId": "cee.inventory",
  "version": "1.3.2",
  "name": "Inventory",
  "description": "Persistent item catalog and basic quantities, in an isolated module service and database.",
  "minimumPlatformVersion": "0.7.0",
  "dependencies": [],
  "requiredPermissions": [
    "storage.own-database"
  ],
  "api": [
    {
      "operationId": "listItems",
      "method": "GET",
      "path": "/items",
      "permission": "cee.inventory.read",
      "query": [
        "limit",
        "offset",
        "fields"
      ]
    },
    {
      "operationId": "createItem",
      "method": "POST",
      "path": "/items",
      "permission": "cee.inventory.write"
    },
    {
      "operationId": "updateItem",
      "method": "PUT",
      "path": "/items/:id",
      "permission": "cee.inventory.write"
    },
    {
      "operationId": "integrationStatus",
      "method": "GET",
      "path": "/integration-status",
      "permission": "cee.inventory.read"
    }
  ],
  "ui": [
    {
      "screenId": "items",
      "title": "Inventory items",
      "navigationLabel": "Inventory",
      "listOperation": "listItems",
      "createOperation": "createItem",
      "updateOperation": "updateItem",
      "fields": [
        {
          "name": "sku",
          "label": "SKU",
          "type": "string",
          "required": true,
          "maxLength": 80
        },
        {
          "name": "name",
          "label": "Item name",
          "type": "string",
          "required": true,
          "maxLength": 160
        },
        {
          "name": "quantity",
          "label": "Quantity",
          "type": "number",
          "required": true,
          "minimum": 0
        },
        {
          "name": "reservedQuantity",
          "label": "Reserved quantity",
          "type": "number",
          "required": true,
          "minimum": 0
        },
        {
          "name": "availableQuantity",
          "label": "Available quantity",
          "type": "number",
          "required": false,
          "readOnly": true
        },
        {
          "name": "minStock",
          "label": "Replenishment threshold",
          "type": "number",
          "minimum": 0,
          "required": true
        }
      ],
      "columns": [
        "sku",
        "name",
        "quantity",
        "availableQuantity",
        "minStock"
      ]
    }
  ],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "quantityUnit"
    ],
    "properties": {
      "quantityUnit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "default": "units"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 4,
    "migrations": [],
    "destructiveRollback": false
  },
  "integrationEvents": [
    {
      "name": "cee.inventory.stock-replenishment",
      "version": 1,
      "direction": "produced"
    },
    {
      "name": "cee.inventory.goods-received",
      "version": 1,
      "direction": "consumed"
    }
  ],
  "analyticalCapabilities": [],
  "replication": {
    "contractVersion": 1,
    "streams": [
      {
        "streamId": "items",
        "table": "inventory_items",
        "idColumn": "item_id",
        "revisionColumn": "revision",
        "columns": [
          "item_id",
          "revision",
          "sku",
          "name",
          "quantity",
          "reserved_quantity",
          "min_stock"
        ]
      },
      {
        "streamId": "replenishment_requirements",
        "table": "replenishment_requirements",
        "idColumn": "id",
        "revisionColumn": "revision",
        "columns": [
          "id",
          "revision",
          "projection"
        ]
      }
    ]
  },
  "mcpTools": [
    {
      "name": "get_inventory_summary",
      "description": "Read inventory items and quantity information from this Worker inventory service.",
      "operationId": "listItems"
    }
  ],
  "integration": {
    "version": 1,
    "outboxPath": "/integration-outbox",
    "acknowledgmentPath": "/integration-ack",
    "inboxPath": "/integration-inbox",
    "peers": [
      {
        "moduleId": "cee.sales",
        "minimumVersion": "1.0.0",
        "sends": [],
        "receives": [
          {
            "command": "stock.reserve",
            "version": 1
          },
          {
            "command": "stock.release",
            "version": 1
          },
          {
            "command": "stock.consume",
            "version": 1
          }
        ]
      },
      {
        "moduleId": "cee.procurement",
        "minimumVersion": "1.0.0",
        "sends": [
          {
            "command": "stock.replenishment",
            "version": 1
          }
        ],
        "receives": [
          {
            "command": "goods.received",
            "version": 1
          }
        ]
      }
    ]
  }
}

{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "moduleId": "cee.inventory",
  "version": "1.5.0",
  "name": "Inventory",
  "description": "Persistent item catalog and basic quantities, in an isolated module service and database.",
  "minimumPlatformVersion": "0.13.0",
  "dependencies": [],
  "requiredPermissions": [
    "storage.own-database"
  ],
  "api": [
    {
      "operationId": "listItems",
      "method": "GET",
      "path": "/items",
      "permission": "cee.inventory.read",
      "query": [
        "limit",
        "offset",
        "fields"
      ]
    },
    {
      "operationId": "createItem",
      "method": "POST",
      "path": "/items",
      "permission": "cee.inventory.write"
    },
    {
      "operationId": "updateItem",
      "method": "PUT",
      "path": "/items/:id",
      "permission": "cee.inventory.write"
    },
    {
      "operationId": "integrationStatus",
      "method": "GET",
      "path": "/integration-status",
      "permission": "cee.inventory.read"
    },
    {
      "operationId": "listServiceStock",
      "method": "GET",
      "path": "/service-stock",
      "permission": "cee.inventory.service.manage",
      "query": [
        "limit",
        "offset"
      ]
    },
    {
      "operationId": "createServiceStock",
      "method": "POST",
      "path": "/service-stock",
      "permission": "cee.inventory.service.manage"
    },
    {
      "operationId": "updateServiceStock",
      "method": "PUT",
      "path": "/service-stock/:id",
      "permission": "cee.inventory.service.manage"
    },
    {
      "operationId": "listServiceSources",
      "method": "GET",
      "path": "/service-sources",
      "permission": "cee.inventory.service.manage",
      "query": [
        "limit",
        "offset"
      ]
    },
    {
      "operationId": "createServiceSource",
      "method": "POST",
      "path": "/service-sources",
      "permission": "cee.inventory.service.manage"
    },
    {
      "operationId": "approveServiceSource",
      "method": "POST",
      "path": "/approve-service-source/:id",
      "permission": "cee.inventory.service.manage"
    },
    {
      "operationId": "revokeServiceSource",
      "method": "POST",
      "path": "/revoke-service-source/:id",
      "permission": "cee.inventory.service.manage"
    },
    {
      "operationId": "programAuthority",
      "method": "GET",
      "path": "/program-authority",
      "permission": "cee.inventory.service.manage",
      "query": [
        "q"
      ]
    }
  ],
  "ui": [
    {
      "screenId": "items",
      "title": "Inventory items",
      "navigationLabel": "Inventory",
      "listOperation": "listItems",
      "createOperation": "createItem",
      "updateOperation": "updateItem",
      "fields": [
        {
          "name": "sku",
          "label": "SKU",
          "type": "string",
          "required": true,
          "maxLength": 80
        },
        {
          "name": "name",
          "label": "Item name",
          "type": "string",
          "required": true,
          "maxLength": 160
        },
        {
          "name": "quantity",
          "label": "Quantity",
          "type": "number",
          "required": true,
          "minimum": 0
        },
        {
          "name": "reservedQuantity",
          "label": "Reserved quantity",
          "type": "number",
          "required": true,
          "minimum": 0
        },
        {
          "name": "availableQuantity",
          "label": "Available quantity",
          "type": "number",
          "required": false,
          "readOnly": true
        },
        {
          "name": "minStock",
          "label": "Replenishment threshold",
          "type": "number",
          "minimum": 0,
          "required": true
        }
      ],
      "columns": [
        "sku",
        "name",
        "quantity",
        "availableQuantity",
        "minStock"
      ]
    },
    {
      "workspace": "business",
      "screenId": "service-stock",
      "title": "Private service supplies",
      "navigationLabel": "Private service supplies",
      "listOperation": "listServiceStock",
      "createOperation": "createServiceStock",
      "updateOperation": "updateServiceStock",
      "fields": [
        {
          "name": "reference",
          "label": "Private stock reference",
          "type": "string",
          "required": true,
          "generate": "uuid"
        },
        {
          "name": "name",
          "label": "Supply name",
          "type": "string",
          "required": true
        },
        {
          "name": "quantity",
          "label": "Stock quantity",
          "type": "number",
          "required": true
        },
        {
          "name": "minStock",
          "label": "Shortage threshold",
          "type": "number",
          "required": true
        },
        {
          "name": "reserved",
          "label": "Reserved units",
          "type": "number",
          "required": false,
          "readOnly": true
        },
        {
          "name": "available",
          "label": "Available units",
          "type": "number",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "name",
        "quantity",
        "reserved",
        "available",
        "minStock"
      ]
    },
    {
      "workspace": "administration",
      "screenId": "service-sources",
      "title": "Private supply service relationships",
      "navigationLabel": "Supply service relationships",
      "listOperation": "listServiceSources",
      "createOperation": "createServiceSource",
      "fields": [
        {
          "name": "reference",
          "label": "Service relationship reference",
          "type": "string",
          "required": true,
          "generate": "uuid"
        },
        {
          "name": "sourceEntityId",
          "label": "Authorized source legal entity",
          "type": "string",
          "required": true
        },
        {
          "name": "sourceInstallationId",
          "label": "Authorized source Worker installation",
          "type": "string",
          "required": true
        },
        {
          "name": "sourceProgramId",
          "label": "Authorized source programme",
          "type": "string",
          "required": true
        },
        {
          "name": "sourceModuleId",
          "label": "Authorized source module",
          "type": "string",
          "required": true
        },
        {
          "name": "expiresAt",
          "label": "Authority expires (UTC)",
          "type": "string",
          "required": true
        },
        {
          "name": "reason",
          "label": "Reviewed service purpose",
          "type": "string",
          "required": true
        },
        {
          "name": "status",
          "label": "Status",
          "type": "string",
          "required": false,
          "readOnly": true
        },
        {
          "name": "reviewedBy",
          "label": "Reviewer account",
          "type": "string",
          "required": false,
          "readOnly": true
        }
      ],
      "columns": [
        "sourceEntityId",
        "sourceProgramId",
        "expiresAt",
        "status"
      ],
      "actions": [
        {
          "label": "Approve supply relationship",
          "operationId": "approveServiceSource",
          "confirmation": "Approve this explicit source entity, Worker and programme for private supplies until the recorded expiry?"
        },
        {
          "label": "Revoke supply relationship",
          "operationId": "revokeServiceSource",
          "confirmation": "Revoke new access to this private supply relationship? Existing reservations remain recorded and require reconciliation."
        }
      ]
    }
  ],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "quantityUnit"
    ],
    "properties": {
      "quantityUnit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "default": "units"
      },
      "integrationsEnabled": {
        "type": "boolean",
        "default": false
      },
      "syntheticServiceStock": {
        "type": "boolean",
        "default": false
      },
      "serviceAuthorityProgramId": {
        "type": "string",
        "pattern": "^(?:|[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12})$",
        "default": ""
      }
    }
  },
  "persistence": {
    "isolation": "dedicated-database",
    "schemaVersion": 5,
    "migrations": [],
    "destructiveRollback": false
  },
  "integrationEvents": [
    {
      "name": "cee.inventory.stock-replenishment",
      "version": 1,
      "direction": "produced"
    },
    {
      "name": "cee.inventory.goods-received",
      "version": 1,
      "direction": "consumed"
    }
  ],
  "analyticalCapabilities": [],
  "replication": {
    "contractVersion": 1,
    "streams": [
      {
        "streamId": "items",
        "table": "inventory_items",
        "idColumn": "item_id",
        "revisionColumn": "revision",
        "columns": [
          "item_id",
          "revision",
          "sku",
          "name",
          "quantity",
          "reserved_quantity",
          "min_stock"
        ]
      },
      {
        "streamId": "replenishment_requirements",
        "table": "replenishment_requirements",
        "idColumn": "id",
        "revisionColumn": "revision",
        "columns": [
          "id",
          "revision",
          "projection"
        ]
      }
    ]
  },
  "mcpTools": [
    {
      "name": "get_inventory_summary",
      "description": "Read inventory items and quantity information from this Worker inventory service.",
      "operationId": "listItems"
    }
  ],
  "integration": {
    "version": 1,
    "outboxPath": "/integration-outbox",
    "acknowledgmentPath": "/integration-ack",
    "inboxPath": "/integration-inbox",
    "peers": [
      {
        "moduleId": "cee.sales",
        "minimumVersion": "1.0.0",
        "sends": [],
        "receives": [
          {
            "command": "stock.reserve",
            "version": 1
          },
          {
            "command": "stock.release",
            "version": 1
          },
          {
            "command": "stock.consume",
            "version": 1
          }
        ]
      },
      {
        "moduleId": "cee.procurement",
        "minimumVersion": "1.0.0",
        "sends": [
          {
            "command": "stock.replenishment",
            "version": 1
          }
        ],
        "receives": [
          {
            "command": "goods.received",
            "version": 1
          }
        ]
      }
    ]
  },
  "smart": {
    "version": 1,
    "provides": [
      {
        "capabilityId": "inventory.stock.reserve",
        "contract": "steward.stock-reservations",
        "version": "1.0.0",
        "operations": [
          {
            "name": "stock.reserve",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000000
                      }
                    },
                    "required": [
                      "sku",
                      "quantity"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "lines"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "requested": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "availableBefore": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "reserved": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "sku",
                      "requested",
                      "availableBefore",
                      "reserved"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "lines"
              ]
            },
            "command": "stock.reserve",
            "permission": "cee.inventory.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          },
          {
            "name": "stock.release",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                }
              },
              "required": [
                "orderId"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "released": {
                  "const": true
                }
              },
              "required": [
                "orderId",
                "released"
              ]
            },
            "command": "stock.release",
            "permission": "cee.inventory.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          },
          {
            "name": "stock.consume",
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "fulfillmentId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sku": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "\\S"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000000
                      }
                    },
                    "required": [
                      "sku",
                      "quantity"
                    ]
                  }
                }
              },
              "required": [
                "orderId",
                "fulfillmentId",
                "lines"
              ]
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orderId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "fulfillmentId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "applied": {
                  "const": true
                }
              },
              "required": [
                "orderId",
                "fulfillmentId",
                "applied"
              ]
            },
            "command": "stock.consume",
            "permission": "cee.inventory.write",
            "mode": "durable",
            "idempotency": "required",
            "retry": "safe"
          }
        ],
        "events": [],
        "sensitivity": "business",
        "scope": "entity",
        "ownership": "provider"
      },

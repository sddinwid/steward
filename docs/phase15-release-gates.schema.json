              "unverified",
              "in-progress",
              "passed",
              "failed"
            ]
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",

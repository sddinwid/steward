FROM node:24.13.0-alpine AS build
WORKDIR /app
COPY package*.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY tools ./tools
RUN npm ci
ARG APP
RUN npm run build -w @steward/module-sdk && npm run build -w @steward/catalog-kit && npm run build -w @steward/contracts && npm run build -w @steward/business-kit && npm run build -w @steward/commerce-kit && npm run build -w @steward/mission-kit && npm run build -w @steward/platform && npm run build -w @steward/${APP}-api
RUN npm prune --omit=dev

FROM node:24.13.0-alpine AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages/contracts ./packages/contracts
COPY --from=build --chown=node:node /app/packages/platform ./packages/platform
COPY --from=build --chown=node:node /app/packages/module-sdk ./packages/module-sdk
COPY --from=build --chown=node:node /app/packages/catalog-kit ./packages/catalog-kit
COPY --from=build --chown=node:node /app/packages/business-kit ./packages/business-kit
COPY --from=build --chown=node:node /app/packages/commerce-kit ./packages/commerce-kit
COPY --from=build --chown=node:node /app/packages/mission-kit ./packages/mission-kit
COPY --chown=node:node datasets/scientific-history-v1.json ./datasets/scientific-history-v1.json
ARG APP
COPY --from=build --chown=node:node /app/apps/${APP}-api ./apps/${APP}-api
ENV APP_ENTRY=apps/${APP}-api/dist/index.js
USER node
EXPOSE 3000
HEALTHCHECK --interval=5s --timeout=4s --start-period=10s --retries=12 CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "exec node \"$APP_ENTRY\""]
